{
  "name": "gatherly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.mjs package.json tsconfig.json vercel.json .github/workflows/quality.yml",
    "format": "prettier --write src tests *.ts *.mjs package.json tsconfig.json vercel.json .github/workflows/quality.yml",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "lucide-react": "^0.552.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
